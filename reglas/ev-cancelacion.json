    {
      "id": "R-GEC001-C1",
      "campo": "GEC001",
      "tipo": "condicional",
      "texto": "El grupo de cancelación es obligatorio si dTiGDE=1 (Cancelación)",
      "condicion": {
        "campo": "GDE006",
        "op": "igual",
        "valor": "1"
      },
      "contradiccion": "C-601",
